{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user profile information.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "description": "User's email address." },
        "name": { "type": "string", "description": "User's display name." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of account creation." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Timestamp of last profile update." },
        "settings": {
          "type": "object",
          "description": "User-specific settings.",
          "properties": {
            "theme": { "type": "string", "enum": ["light", "dark", "system"], "description": "The user's preferred theme." },
            "targetRole": { "type": "string", "description": "The user's target job role for resume optimization." },
            "language": { "type": "string", "description": "The user's preferred language." },
            "onboardingCompleted": { "type": "boolean", "description": "Whether the user has completed the onboarding guide." }
          },
          "required": ["theme"]
        }
      },
      "required": ["email", "createdAt"]
    },
    "ResumeAnalysis": {
      "title": "Resume Analysis",
      "description": "Stores the results of an AI-powered resume analysis.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "resumeText": { "type": "string" },
        "atsScore": { "type": "number" },
        "missingKeywords": { "type": "array", "items": { "type": "string" } },
        "skillGaps": { "type": "array", "items": { "type": "string" } },
        "formattingIssues": { "type": "array", "items": { "type": "string" } },
        "bulletPointImprovements": { "type": "array", "items": { "type": "string" } },
        "roleSpecificSuggestions": { "type": "array", "items": { "type": "string" } },
        "summaryRewrite": { "type": "string" },
        "overallFeedback": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "resumeText", "atsScore", "createdAt"]
    },
    "JobMatch": {
      "title": "Job Match",
      "description": "Stores the results of matching a resume against a job description.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "resumeText": { "type": "string" },
        "jobDescription": { "type": "string" },
        "matchPercentage": { "type": "number" },
        "missingSkills": { "type": "array", "items": { "type": "string" } },
        "resumeImprovementSuggestions": { "type": "array", "items": { "type": "string" } },
        "roleSpecificFeedback": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "resumeText", "jobDescription", "matchPercentage", "createdAt"]
    },
    "ActivityHistory": {
      "title": "Activity History",
      "description": "A log of user activities within the app.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["RESUME_ANALYSIS", "JOB_MATCH", "BULLET_REWRITE"] },
        "referenceId": { "type": "string", "description": "ID of the related document (e.g., analysisId, jobMatchId)." },
        "details": { "type": "object", "properties": {}, "description": "Summary of the activity, e.g., { score: 82, resumeVersion: 'v3' }." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "createdAt"]
    },
    "SupportMessage": {
      "title": "Support Message",
      "description": "Represents a message sent through the support form.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The ID of the user sending the message." },
        "name": { "type": "string", "description": "The name of the user." },
        "email": { "type": "string", "format": "email", "description": "The email of the user." },
        "subject": { "type": "string", "description": "The subject of the support message." },
        "message": { "type": "string", "description": "The content of the support message." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the message was sent." }
      },
      "required": ["userId", "name", "email", "subject", "message", "createdAt"]
    }
  },
  "auth": {
    "providers": ["email", "google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores user profile information, keyed by user ID."
    },
    "/resumeAnalyses/{analysisId}": {
        "schema": { "$ref": "#/entities/ResumeAnalysis" },
        "description": "Top-level collection for all resume analyses."
    },
    "/jobMatches/{jobMatchId}": {
        "schema": { "$ref": "#/entities/JobMatch" },
        "description": "Top-level collection for all job matches."
    },
    "/activityHistory/{activityId}": {
        "schema": { "$ref": "#/entities/ActivityHistory" },
        "description": "Top-level collection for all user activities."
    },
    "/supportMessages/{messageId}": {
        "schema": { "$ref": "#/entities/SupportMessage" },
        "description": "Stores messages submitted through the contact/support form."
    }
  }
}
